{
  "name": "claude-switcher",
  "version": "1.0.0",
  "description": "CLI tool to switch Claude Code between AI model providers",
  "main": "dist/cli.js",
  "bin": {
    "claude-switch": "./bin/claude-switch"
  },
  "scripts": {
    "start": "ts-node src/cli.tsx",
