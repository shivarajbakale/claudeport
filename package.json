{
  "name": "@shivarajbakale/claudeport",
  "version": "1.0.1",
  "description": "Switch Claude Code between AI model providers in one command. Supports DeepSeek, MiniMax, Groq, Moonshot, OpenRouter, and more.",
  "type": "module",
  "main": "dist/cli.js",
  "bin": {
    "claudeport": "./bin/claude-switch"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "start": "ts-node src/cli.tsx",
    "build": "tsc && node scripts/add-js-extensions.mjs",
    "dev": "ts-node-dev --respawn src/cli.tsx",
    "test": "jest",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist",
    "bin"
  ],
  "keywords": [
    "claude",
    "claude-code",
    "anthropic",
    "ai",
    "llm",
    "cli",
    "model-switcher",
    "deepseek",
    "groq",
    "moonshot",
    "openrouter",
    "minimax",
    "provider-switcher"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "jest": "^30.3.0",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "ink": "^6.8.0",
    "ink-select-input": "^6.2.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "react": "^19.2.4"
  }
}
